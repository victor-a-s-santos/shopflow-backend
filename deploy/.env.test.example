# Copie para .env.test e preencha os valores reais.
# cp .env.test.example .env.test
#
# Variáveis do container api-test e worker-test.
# Credenciais do Postgres ficam em .env (ver .env.example).

# --- Ambiente (ASPNETCORE_* também definidos no docker-compose.yml) ---
ASPNETCORE_ENVIRONMENT=Testing
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTP_PORTS=8080

# --- URLs públicas (documentação / referência operacional) ---
SHOPFLOW_PUBLIC_WEB_ORIGIN=https://teste.vipassessoriadigital.com.br
SHOPFLOW_PUBLIC_API_ORIGIN=https://api-teste.vipassessoriadigital.com.br

# --- Postgres (connection strings) ---
ConnectionStrings__Catalog=Host=postgres;Port=5432;Database=shopflow_test;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Inventory=Host=postgres;Port=5432;Database=shopflow_test;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__CartCheckout=Host=postgres;Port=5432;Database=shopflow_test;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Orders=Host=postgres;Port=5432;Database=shopflow_test;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__PaymentsPix=Host=postgres;Port=5432;Database=shopflow_test;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__IdentityAccess=Host=postgres;Port=5432;Database=shopflow_test;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD

# --- DataProtection (cookies admin/customer + CSRF) ---
DataProtection__KeysPath=/app/dataprotection-keys

# --- Uploads ---
Uploads__RootPath=/app/wwwroot/uploads
Uploads__PublicBaseUrl=https://api-teste.vipassessoriadigital.com.br

# --- CORS ---
AllowedOrigins__0=https://teste.vipassessoriadigital.com.br

# --- Demo catalog seed (roupas) ---
DemoCatalogSeed__Enabled=true
DemoCatalogSeed__CopyImages=true
DemoCatalogSeed__CreateInventory=true
DemoCatalogSeed__DefaultStockQuantity=20

# --- Admin seed (obrigatório em Testing — API falha no startup se ausente) ---
SHOPFLOW_ADMIN_EMAIL=admin-teste@vipassessoriadigital.com.br
SHOPFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SHOPFLOW_ADMIN_RESET_PASSWORD=false
# SHOPFLOW_ADMIN_NAME=Shopflow Admin Teste

# --- Expiration worker ---
ExpirationWorker__Enabled=true
ExpirationWorker__IntervalSeconds=60
ExpirationWorker__BatchSize=50
ExpirationWorker__CheckoutSessionTtlMinutes=15
ExpirationWorker__PixPaymentTtlMinutes=15

# --- Guest order access (obrigatório TokenHashSecret se Enabled=true) ---
GuestOrderAccess__Enabled=true
GuestOrderAccess__TokenTtlDays=30
GuestOrderAccess__TokenHashSecret=CHANGE_ME_GUEST_ORDER_TOKEN_HASH_SECRET
GuestOrderAccess__RateLimitPerMinute=30

# --- PaymentsPix / Mercado Pago ---
PaymentsPix__Provider=Fake
MercadoPago__Enabled=false
MercadoPago__Environment=Sandbox
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__ApplicationId=
MercadoPago__UserId=
MercadoPago__BaseUrl=https://api.mercadopago.com
MercadoPago__WebhookSecret=
MercadoPago__NotificationUrl=
MercadoPago__PixExpirationMinutes=30
MercadoPago__WebhookSignatureToleranceMinutes=10
MercadoPago__SandboxPayerFirstNameOverride=
# Assinatura webhook (doc oficial MP): usa Query data.id (lowercase no HMAC),
# header x-request-id, ts/v1 de x-signature. Evento correto: Order (Mercado Pago).
# WebhookSecret deve ser da mesma aplicação do AccessToken. Nunca logar o valor.
# NotificationUrl exemplo (teste): https://api-teste.vipassessoriadigital.com.br/api/payments/pix/webhooks/mercado-pago
