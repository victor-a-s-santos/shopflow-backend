# Copie para .env.test na VPS (nunca commitar o arquivo real com secrets).
# cp deploy/.env.test.example deploy/.env.test
#
# Usado por deploy/docker-compose.yml → api-test / worker-test (env_file).

ASPNETCORE_ENVIRONMENT=Testing

# --- Postgres / connections (preencher na VPS) ---
# ConnectionStrings__Catalog=...
# ConnectionStrings__Inventory=...
# ...

# --- Product images: Cloudflare R2 (TESTE) ---
Storage__Provider=CloudflareR2
Storage__MaxImageBytes=5242880
Storage__R2__Endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
Storage__R2__AccountId=<ACCOUNT_ID>
Storage__R2__Bucket=shopflow-products-test
Storage__R2__AccessKeyId=<R2_ACCESS_KEY_ID>
Storage__R2__SecretAccessKey=<R2_SECRET_ACCESS_KEY>
Storage__R2__Region=auto
Storage__R2__ForcePathStyle=true
Storage__R2__PublicBaseUrl=https://assets-teste.vipassessoriadigital.com.br
Storage__R2__KeyPrefix=products

# Local fallback / backfill source root (não usado para upload novo quando Provider=CloudflareR2)
Storage__Local__RootPath=/app/wwwroot/uploads
Storage__Local__PublicBaseUrl=

# Manual TEST-only image backfill (default false). Never enable in Production.
R2ImageBackfill__Enabled=false

# --- Transactional email (TESTE: sandbox primeiro; ApiKey só na VPS, nunca no git) ---
# PublicApp__BaseUrl=https://<frontend-teste>
# PublicApp__AdminBaseUrl=https://<admin-teste>
# PublicApp__StoreName=Vip Assessoria
# AppUrls__StorefrontBaseUrl=https://<frontend-teste>
# AppUrls__AdminBaseUrl=https://<admin-teste>
# AdminNotifications__ApprovalRequestsEmail=ops@vipassessoriadigital.com.br
# Brevo__Enabled=true
# Brevo__BaseUrl=https://api.brevo.com
# Brevo__ApiKey=
# Brevo__SenderName=VIP Assessoria Digital
# Brevo__SenderEmail=no-reply@vipassessoriadigital.com.br
# Brevo__ReplyToName=Atendimento
# Brevo__ReplyToEmail=atendimento@vipassessoriadigital.com.br
# Brevo__SandboxMode=true
# Brevo__TimeoutSeconds=10
# EmailOutbox__Enabled=true
# EmailOutbox__IntervalSeconds=15
# EmailOutbox__BatchSize=20
# EmailOutbox__MaxAttempts=8
# EmailOutbox__ProcessingTimeoutSeconds=120
# OrderEmailIntentDispatcher__Enabled=true
# OrderEmailIntentDispatcher__IntervalSeconds=15
# OrderEmailIntentDispatcher__BatchSize=20

# Store access / customer approval (loja B2B privada)
StoreAccess__Mode=Closed
CustomerAccess__RequireApproval=true
Checkout__AllowGuest=false
Checkout__AllowGuestCheckout=false

# Admin seed (obrigatório em Testing). RESET=true só durante rotação; depois false e recreate.
SHOPFLOW_ADMIN_EMAIL=admin-teste@vipassessoriadigital.com.br
SHOPFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SHOPFLOW_ADMIN_RESET_PASSWORD=false
# SHOPFLOW_ADMIN_NAME=Shopflow Admin TESTE

# Usuários demo para login local/TESTE (Owner + cliente já Approved). Proibido em Production.
# No ambiente Testing o seed liga sozinho se esta flag estiver ausente; use false para desligar.
SHOPFLOW_DEMO_USERS_ENABLED=true
SHOPFLOW_DEMO_USERS_RESET_PASSWORD=false
SHOPFLOW_DEMO_ADMIN_EMAIL=admin@teste.com.br
SHOPFLOW_DEMO_ADMIN_PASSWORD=Shopflow@123
SHOPFLOW_DEMO_ADMIN_NAME=Admin Teste
SHOPFLOW_DEMO_CUSTOMER_EMAIL=teste@teste.com.br
SHOPFLOW_DEMO_CUSTOMER_PASSWORD=Shopflow@123
SHOPFLOW_DEMO_CUSTOMER_NAME=Cliente Teste

