# Copie para .env.prod na VPS PROD (nunca commitar o arquivo real com secrets).
# cp deploy/.env.prod.example deploy/.env.prod
#
# Usado por deploy/docker-compose.prod.yml → api-prod / worker-prod (env_file).
# Credenciais do Postgres (interpolação do Compose) ficam em deploy/.env
# (copie de .env.example). A senha de .env deve ser a mesma das connection strings.
#
# ADR: docs/infra/ADR-005-production-infrastructure.md
# Runbook: docs/infra/RUNBOOK-006-production-vps-setup.md
# Nunca usar credenciais, buckets ou API keys de TESTE/HML aqui.

# --- Ambiente (ASPNETCORE_* / DOTNET_* também forçados no docker-compose.prod.yml) ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTP_PORTS=8080

# --- URLs públicas ---
SHOPFLOW_PUBLIC_WEB_ORIGIN=https://vipassessoriadigital.com.br
SHOPFLOW_PUBLIC_API_ORIGIN=https://api.vipassessoriadigital.com.br

# --- Postgres (connection strings) ---
# Host=postgres é o nome do serviço no docker-compose.prod.yml (rede interna).
# Porta 5432 NÃO é publicada no host.
ConnectionStrings__Catalog=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Inventory=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__CartCheckout=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Orders=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__PaymentsPix=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__IdentityAccess=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Notifications=Host=postgres;Port=5432;Database=shopflow_prod;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD

# --- DataProtection (cookies admin/customer + CSRF) ---
# Volume Docker: shopflow_dataprotection_prod → /app/dataprotection-keys
DataProtection__KeysPath=/app/dataprotection-keys

# --- Product images: Cloudflare R2 (PROD, bucket separado do TESTE) ---
# Nenhuma imagem PROD deve depender do filesystem da API.
Storage__Provider=CloudflareR2
Storage__MaxImageBytes=5242880
Storage__R2__Endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
Storage__R2__AccountId=<ACCOUNT_ID>
Storage__R2__Bucket=shopflow-products-prod
Storage__R2__AccessKeyId=<R2_ACCESS_KEY_ID>
Storage__R2__SecretAccessKey=<R2_SECRET_ACCESS_KEY>
Storage__R2__Region=auto
Storage__R2__ForcePathStyle=true
Storage__R2__PublicBaseUrl=https://assets.vipassessoriadigital.com.br
Storage__R2__KeyPrefix=products
Storage__Local__RootPath=/app/wwwroot/uploads
Storage__Local__PublicBaseUrl=
Uploads__RootPath=/app/wwwroot/uploads
Uploads__PublicBaseUrl=https://api.vipassessoriadigital.com.br
R2ImageBackfill__Enabled=false

# --- CORS (Cloudflare Pages — apex + www) ---
AllowedOrigins__0=https://vipassessoriadigital.com.br
AllowedOrigins__1=https://www.vipassessoriadigital.com.br

# --- Demo catalog seed — PROIBIDO em produção ---
DemoCatalogSeed__Enabled=false
DemoCatalogSeed__CopyImages=false
DemoCatalogSeed__CreateInventory=false

# --- Admin seed (obrigatório fora de Development — API falha no startup se ausente) ---
# Credenciais próprias de PROD. Nunca reutilizar TESTE/HML.
SHOPFLOW_ADMIN_EMAIL=admin@vipassessoriadigital.com.br
SHOPFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SHOPFLOW_ADMIN_RESET_PASSWORD=false
SHOPFLOW_ADMIN_NAME=Shopflow Admin

# --- Expiration worker ---
ExpirationWorker__Enabled=true
ExpirationWorker__IntervalSeconds=60
ExpirationWorker__BatchSize=50
ExpirationWorker__CheckoutSessionTtlMinutes=15
ExpirationWorker__PixPaymentTtlMinutes=15

# --- Guest order access (TokenHashSecret obrigatório se Enabled=true) ---
GuestOrderAccess__Enabled=true
GuestOrderAccess__TokenTtlDays=30
GuestOrderAccess__TokenHashSecret=CHANGE_ME_GUEST_ORDER_TOKEN_HASH_SECRET
GuestOrderAccess__RateLimitPerMinute=30

# --- PaymentsPix / Mercado Pago (credenciais Production — nunca Sandbox) ---
PaymentsPix__Provider=MercadoPago
MercadoPago__Enabled=true
MercadoPago__Environment=Production
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__ApplicationId=
MercadoPago__UserId=
MercadoPago__BaseUrl=https://api.mercadopago.com
MercadoPago__WebhookSecret=
MercadoPago__SendNotificationUrlInOrderCreate=false
MercadoPago__NotificationUrl=https://api.vipassessoriadigital.com.br/api/payments/pix/webhooks/mercado-pago
MercadoPago__PixExpirationMinutes=30
MercadoPago__WebhookSignatureToleranceMinutes=10
MercadoPagoReconciliation__Enabled=true
MercadoPagoReconciliation__IntervalSeconds=60
MercadoPagoReconciliation__BatchSize=20
MercadoPagoReconciliation__MaxAgeMinutes=180
# NUNCA preencher em produção (sandbox only).
MercadoPago__SandboxPayerFirstNameOverride=
MercadoPago__WebhookRawCaptureEnabled=false
MercadoPago__WebhookRawCaptureMaxEvents=5

# --- Store access / customer approval (loja B2B privada) ---
StoreAccess__Mode=Closed
CustomerAccess__RequireApproval=true
Checkout__AllowGuest=false
Checkout__AllowGuestCheckout=false

# --- CEP ---
PostalCodeLookup__Enabled=true
PostalCodeLookup__Provider=ViaCep
PostalCodeLookup__BaseUrl=https://viacep.com.br
PostalCodeLookup__TimeoutSeconds=5
PostalCodeLookup__RateLimitPerMinute=60

# --- Frontend / links em e-mails ---
PublicApp__BaseUrl=https://vipassessoriadigital.com.br
PublicApp__AdminBaseUrl=https://vipassessoriadigital.com.br
PublicApp__StoreName=Vip Assessoria
AppUrls__StorefrontBaseUrl=https://vipassessoriadigital.com.br
AppUrls__AdminBaseUrl=https://vipassessoriadigital.com.br
AdminNotifications__ApprovalRequestsEmail=

# --- Brevo PROD (API key só na VPS; nunca no git) ---
Brevo__Enabled=true
Brevo__BaseUrl=https://api.brevo.com
Brevo__ApiKey=
Brevo__SenderName=VIP Assessoria Digital
Brevo__SenderEmail=no-reply@vipassessoriadigital.com.br
Brevo__ReplyToName=Atendimento
Brevo__ReplyToEmail=atendimento@vipassessoriadigital.com.br
Brevo__SandboxMode=false
Brevo__TimeoutSeconds=10
EmailOutbox__Enabled=true
EmailOutbox__IntervalSeconds=15
EmailOutbox__BatchSize=20
EmailOutbox__MaxAttempts=8
EmailOutbox__ProcessingTimeoutSeconds=120
OrderEmailIntentDispatcher__Enabled=true
OrderEmailIntentDispatcher__IntervalSeconds=15
OrderEmailIntentDispatcher__BatchSize=20
