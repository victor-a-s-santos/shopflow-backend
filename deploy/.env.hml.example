# Copie para .env.hml e preencha os valores reais.
# cp .env.hml.example .env.hml
#
# Variáveis do container api-hml e worker-hml.
# Credenciais do Postgres ficam em .env (ver .env.example).
# Go-live / smoke HML: docs/qa/HML-GO-LIVE-RUNBOOK.md
# Nunca commitar .env.hml real. Nunca usar credenciais Mercado Pago Production aqui.

# --- Ambiente (ASPNETCORE_* também definidos no docker-compose.yml) ---
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTP_PORTS=8080

# --- URLs públicas (documentação / referência operacional) ---
SHOPFLOW_PUBLIC_WEB_ORIGIN=https://hml.vipassessoriadigital.com.br
SHOPFLOW_PUBLIC_API_ORIGIN=https://api-hml.vipassessoriadigital.com.br

# --- Postgres (connection strings) ---
ConnectionStrings__Catalog=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Inventory=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__CartCheckout=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Orders=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__PaymentsPix=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__IdentityAccess=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD

# --- DataProtection (cookies admin/customer + CSRF) ---
DataProtection__KeysPath=/app/dataprotection-keys

# --- Uploads ---
Uploads__RootPath=/app/wwwroot/uploads
Uploads__PublicBaseUrl=https://api-hml.vipassessoriadigital.com.br

# --- CORS ---
AllowedOrigins__0=https://hml.vipassessoriadigital.com.br

# --- Demo catalog seed (roupas) — OK em HML; PROIBIDO em produção ---
DemoCatalogSeed__Enabled=true
DemoCatalogSeed__CopyImages=true
DemoCatalogSeed__CreateInventory=true
DemoCatalogSeed__DefaultStockQuantity=20

# --- Admin seed (obrigatório em Staging — API falha no startup se ausente) ---
SHOPFLOW_ADMIN_EMAIL=admin-hml@vipassessoriadigital.com.br
SHOPFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SHOPFLOW_ADMIN_RESET_PASSWORD=false
# SHOPFLOW_ADMIN_NAME=Shopflow Admin HML

# --- Expiration worker ---
ExpirationWorker__Enabled=true
ExpirationWorker__IntervalSeconds=60
ExpirationWorker__BatchSize=50
ExpirationWorker__CheckoutSessionTtlMinutes=15
ExpirationWorker__PixPaymentTtlMinutes=15

# --- Guest order access (obrigatório TokenHashSecret se Enabled=true) ---
GuestOrderAccess__Enabled=true
GuestOrderAccess__TokenTtlDays=30
GuestOrderAccess__TokenHashSecret=CHANGE_ME_GUEST_ORDER_TOKEN_HASH_SECRET
GuestOrderAccess__RateLimitPerMinute=30

# --- PaymentsPix / Mercado Pago (HML go-live: Sandbox + reconciliação ON) ---
# Copie para .env.hml e preencha AccessToken/WebhookSecret/ApplicationId/UserId reais (nunca commit).
# Ver docs/qa/HML-GO-LIVE-RUNBOOK.md
PaymentsPix__Provider=MercadoPago
MercadoPago__Enabled=true
MercadoPago__Environment=Sandbox
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__ApplicationId=
MercadoPago__UserId=
MercadoPago__BaseUrl=https://api.mercadopago.com
MercadoPago__WebhookSecret=
# Diagnóstico signature_mismatch: compare logs body_application_id/user_id/live_mode com a app do painel; webhook_secret_fingerprint = SHA256(secret)[:8].
# AccessToken e WebhookSecret devem ser da mesma aplicação Sandbox. Nunca use credenciais Production em HML.
# Prefer false to test panel Webhooks URL only (MP: create-time URL has priority over panel).
MercadoPago__SendNotificationUrlInOrderCreate=false
# Fallback MVP: GET /v1/orders (worker). Obrigatório ON em HML enquanto webhook sandbox for instável.
MercadoPagoReconciliation__Enabled=true
MercadoPagoReconciliation__IntervalSeconds=60
MercadoPagoReconciliation__BatchSize=20
MercadoPagoReconciliation__MaxAgeMinutes=180
# Referência operacional; com SendNotificationUrlInOrderCreate=false a URL efetiva é a do painel MP.
MercadoPago__NotificationUrl=https://api-hml.vipassessoriadigital.com.br/api/payments/pix/webhooks/mercado-pago
MercadoPago__PixExpirationMinutes=30
MercadoPago__WebhookSignatureToleranceMinutes=10
# Opcional HML/teste apenas — auto-aprovação sandbox. NUNCA em produção.
MercadoPago__SandboxPayerFirstNameOverride=APRO
# TEMPORARY DIAGNOSTIC ONLY — captura webhook bruto (x-signature, não a secret). Nunca em Production.
# Manter false no go-live HML salvo diagnóstico pontual. docs/payments/MP-PIX-003-webhook-raw-capture-temporary.md
MercadoPago__WebhookRawCaptureEnabled=false
# MercadoPago__WebhookRawCaptureOrderId=
MercadoPago__WebhookRawCaptureMaxEvents=5
# Assinatura webhook: mercadopago-sdk WebhookSignatureValidator (query data.id as-is).
# header x-request-id, ts/v1 de x-signature. Evento: Order (Mercado Pago).
# WebhookSecret da mesma app do AccessToken; sem aspas/espaço no .env. Nunca logar o valor.
# Fingerprint: printf '%s' "$MercadoPago__WebhookSecret" | shasum -a 256 | cut -c1-8
# Painel MP → Webhooks: URL = NotificationUrl acima (HTTPS público da API HML)

# Store access / customer approval (loja B2B privada)
StoreAccess__Mode=PrivateCatalogApprovedOnly
CustomerAccess__RequireApproval=true
Checkout__AllowGuestCheckout=false
