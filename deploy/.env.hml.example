# Copie para .env.hml e preencha os valores reais.
# cp .env.hml.example .env.hml
#
# Variáveis do container api-hml e worker-hml.
# Credenciais do Postgres ficam em .env (ver .env.example).

# --- Ambiente (ASPNETCORE_* também definidos no docker-compose.yml) ---
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTP_PORTS=8080

# --- URLs públicas (documentação / referência operacional) ---
SHOPFLOW_PUBLIC_WEB_ORIGIN=https://hml.vipassessoriadigital.com.br
SHOPFLOW_PUBLIC_API_ORIGIN=https://api-hml.vipassessoriadigital.com.br

# --- Postgres (connection strings) ---
ConnectionStrings__Catalog=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Inventory=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__CartCheckout=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__Orders=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__PaymentsPix=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD
ConnectionStrings__IdentityAccess=Host=postgres;Port=5432;Database=shopflow_hml;Username=shopflow;Password=CHANGE_ME_STRONG_PASSWORD

# --- DataProtection (cookies admin/customer + CSRF) ---
DataProtection__KeysPath=/app/dataprotection-keys

# --- Uploads ---
Uploads__RootPath=/app/wwwroot/uploads
Uploads__PublicBaseUrl=https://api-hml.vipassessoriadigital.com.br

# --- CORS ---
AllowedOrigins__0=https://hml.vipassessoriadigital.com.br

# --- Demo catalog seed (roupas) ---
DemoCatalogSeed__Enabled=true
DemoCatalogSeed__CopyImages=true
DemoCatalogSeed__CreateInventory=true
DemoCatalogSeed__DefaultStockQuantity=20

# --- Admin seed (obrigatório em Staging — API falha no startup se ausente) ---
SHOPFLOW_ADMIN_EMAIL=admin-hml@vipassessoriadigital.com.br
SHOPFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SHOPFLOW_ADMIN_RESET_PASSWORD=false
# SHOPFLOW_ADMIN_NAME=Shopflow Admin HML

# --- Expiration worker ---
ExpirationWorker__Enabled=true
ExpirationWorker__IntervalSeconds=60
ExpirationWorker__BatchSize=50
ExpirationWorker__CheckoutSessionTtlMinutes=15
ExpirationWorker__PixPaymentTtlMinutes=15
