                  "pm.collectionVariables.set('skuId', body.skuId);",
                  "console.log('skuId =', body.skuId);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /catalog/products/{{productId}} (validar skuId)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/catalog/products/{{productId}}"
