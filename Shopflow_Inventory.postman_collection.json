              "mode": "raw",
              "raw": "{\n  \"code\": \"INV-E2E-{{$timestamp}}\",\n  \"regularPrice\": 99.90,\n  \"promotionalPrice\": null,\n  \"active\": true,\n  \"attributes\": [\n    {\n      \"attributeDefinitionId\": \"{{colorDefinitionId}}\",\n      \"attributeValueDefinitionId\": \"{{colorValueId}}\"\n    },\n    {\n      \"attributeDefinitionId\": \"{{sizeDefinitionId}}\",\n      \"attributeValueDefinitionId\": \"{{sizeValueId}}\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/catalog/products/{{productId}}/variants"
