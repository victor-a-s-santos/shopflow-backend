    {
      "name": "0. Setup Catalog (obter skuId)",
      "item": [
        {
          "name": "GET /catalog/categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/catalog/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const cats = pm.response.json();",
                  "pm.test('Categorias disponíveis', () => pm.expect(cats).to.be.an('array').that.is.not.empty);",
                  "const camisetas = cats.find((c) => (c.name || '').toLowerCase().includes('camiseta')) || cats[0];",
                  "pm.collectionVariables.set('categoryId', camisetas.id);",
                  "console.log('categoryId =', camisetas.id, camisetas.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /catalog/attributes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/catalog/attributes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const defs = pm.response.json();",
                  "const findDef = (part) => defs.find((d) => (d.name || '').toLowerCase().includes(part));",
                  "const findValue = (values, names) => {",
                  "  for (const n of names) {",
                  "    const v = (values || []).find((x) => (x.name || '').toLowerCase() === n.toLowerCase());",
                  "    if (v) return v;",
                  "  }",
                  "  return (values || [])[0];",
                  "};",
                  "const cor = findDef('cor');",
                  "const tamanho = findDef('tamanho');",
                  "if (cor) {",
                  "  pm.collectionVariables.set('colorDefinitionId', cor.id);",
                  "  const colorVal = findValue(cor.values, ['Preto', 'Off-White']);",
                  "  if (colorVal) pm.collectionVariables.set('colorValueId', colorVal.id);",
                  "}",
                  "if (tamanho) {",
                  "  pm.collectionVariables.set('sizeDefinitionId', tamanho.id);",
                  "  const sizeVal = findValue(tamanho.values, ['M', 'G']);",
                  "  if (sizeVal) pm.collectionVariables.set('sizeValueId', sizeVal.id);",
                  "}",
                  "pm.test('Atributos capturados', () => {",
                  "  pm.expect(pm.collectionVariables.get('colorDefinitionId')).to.not.be.empty;",
                  "  pm.expect(pm.collectionVariables.get('sizeDefinitionId')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /catalog/products/variant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produto Inventory E2E\",\n  \"slug\": \"produto-inventory-e2e-{{$timestamp}}\",\n  \"categoryId\": \"{{categoryId}}\"\n}"
