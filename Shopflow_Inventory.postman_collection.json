                  "const skuId = pm.collectionVariables.get('skuId');",
                  "pm.test('SKU presente no produto', () => {",
                  "  pm.expect(p.skus.some((s) => s.id === skuId)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
