{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Catalog": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres"
  },
