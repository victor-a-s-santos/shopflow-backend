{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Catalog": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres",
    "Inventory": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres",
    "CartCheckout": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres",
    "Orders": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres",
    "PaymentsPix": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres",
    "IdentityAccess": "Host=localhost;Port=5432;Database=shopflow;Username=postgres;Password=postgres"
  },
  "AllowedOrigins": [
    "http://localhost:8080",
    "http://localhost:5173",
    "http://localhost:3000"
  ],
  "DataProtection": {
    "KeysPath": "./dataprotection-keys"
  },
  "AdminAuth": {
    "SessionHours": 8,
    "CookieNameProduction": "__Host-shopflow_admin",
    "CookieNameDevelopment": "shopflow_admin_dev"
  },
  "CustomerAuth": {
    "SessionDays": 30,
    "CookieNameProduction": "__Host-shopflow_customer",
    "CookieNameDevelopment": "shopflow_customer_dev"
  },
  "Uploads": {
    "RootPath": "",
    "PublicBaseUrl": "http://localhost:5127"
  },
  "DemoCatalogSeed": {
    "Enabled": true,
    "CopyImages": true,
    "CreateInventory": true,
    "DefaultStockQuantity": 20
  },
  "PaymentsPix": {
    "Provider": "Fake"
  },
  "MercadoPago": {
    "Enabled": false,
    "Environment": "Sandbox",
    "AccessToken": "",
    "PublicKey": "",
    "BaseUrl": "https://api.mercadopago.com",
    "ApplicationId": "",
    "UserId": "",
    "WebhookSecret": "",
    "NotificationUrl": "",
    "SendNotificationUrlInOrderCreate": false,
    "PixExpirationMinutes": 30,
    "WebhookSignatureToleranceMinutes": 10,
    "SandboxPayerFirstNameOverride": "",
    "SandboxTestPayerEmail": "test_user_br@testuser.com",
    "WebhookRawCaptureEnabled": false,
    "WebhookRawCaptureOrderId": "",
    "WebhookRawCaptureMaxEvents": 5
  },
  "GuestOrderAccess": {
    "Enabled": true,
    "TokenTtlDays": 30,
    "TokenHashSecret": "dev-only-guest-order-access-secret-change-me",
    "RateLimitPerMinute": 100
  },
  "StoreAccess": {
    "Mode": "PublicCatalogAndGuestCheckout"
  },
  "Checkout": {
    "AllowGuest": true,
    "AllowGuestCheckout": true
  },
  "CustomerAccess": {
    "RequireApproval": false
  },
  "PostalCodeLookup": {
    "Enabled": true,
    "Provider": "ViaCep",
    "BaseUrl": "https://viacep.com.br",
    "TimeoutSeconds": 5,
    "RateLimitPerMinute": 60
  },
  "Storage": {
    "Provider": "Local",
    "MaxImageBytes": 5242880,
    "Local": {
      "RootPath": "",
      "PublicBaseUrl": "http://localhost:5127"
    },
    "R2": {
      "Endpoint": "",
      "AccountId": "",
      "Bucket": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "auto",
      "ForcePathStyle": true,
      "PublicBaseUrl": "",
      "KeyPrefix": "products"
    }
  }
}
