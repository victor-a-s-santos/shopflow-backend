# Copie para .env na raiz do monorepo (usado pelo docker compose).
# cp .env.example .env

# Seed do admin no primeiro startup da API
SHOPFLOW_ADMIN_EMAIL=admin@teste.com.br
SHOPFLOW_ADMIN_PASSWORD=Shopflow@123
SHOPFLOW_ADMIN_NAME=Admin Teste
# true só durante rotação temporária (RUNBOOK-001). No dia a dia: false, senão cada recreate reseta a senha.
SHOPFLOW_ADMIN_RESET_PASSWORD=false

# Usuários demo (Owner + cliente Approved). Só local/TESTE — nunca Production.
# SHOPFLOW_DEMO_USERS_ENABLED=false desliga o seed mesmo em Development.
SHOPFLOW_DEMO_USERS_ENABLED=true
SHOPFLOW_DEMO_USERS_RESET_PASSWORD=false
SHOPFLOW_DEMO_ADMIN_EMAIL=admin@teste.com.br
SHOPFLOW_DEMO_ADMIN_PASSWORD=Shopflow@123
SHOPFLOW_DEMO_ADMIN_NAME=Admin Teste
SHOPFLOW_DEMO_CUSTOMER_EMAIL=teste@teste.com.br
SHOPFLOW_DEMO_CUSTOMER_PASSWORD=Shopflow@123
SHOPFLOW_DEMO_CUSTOMER_NAME=Cliente Teste

# Cypress (opcional — mesmo par de credenciais)
# CYPRESS_ADMIN_EMAIL=admin.integration@test.local
# CYPRESS_ADMIN_PASSWORD=TesteAdmin@123

# PaymentsPix — provider: Fake | MercadoPago
PaymentsPix__Provider=Fake

# Mercado Pago (Checkout Transparente / Pix via Orders API)
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
MercadoPago__Enabled=false
MercadoPago__Environment=Sandbox
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__ApplicationId=
MercadoPago__UserId=
MercadoPago__BaseUrl=https://api.mercadopago.com
MercadoPago__WebhookSecret=
MercadoPago__NotificationUrl=
# false = use only Webhooks panel URL (recommended for signature tests). true = send notification_url on POST /v1/orders (takes priority over panel).
MercadoPago__SendNotificationUrlInOrderCreate=false
MercadoPago__PixExpirationMinutes=30
MercadoPago__WebhookSignatureToleranceMinutes=10
# Sandbox MP: order Pix predefinida com auto-aprovação (opcional)
MercadoPago__SandboxPayerFirstNameOverride=APRO
# TEMPORARY DIAGNOSTIC ONLY — raw webhook capture (never Production). See docs/payments/MP-PIX-003-webhook-raw-capture-temporary.md
MercadoPago__WebhookRawCaptureEnabled=false
# MercadoPago__WebhookRawCaptureOrderId=
MercadoPago__WebhookRawCaptureMaxEvents=5
# Fallback GET /v1/orders for pending MercadoPago Pix (worker). Does not replace webhooks.
MercadoPagoReconciliation__Enabled=false
MercadoPagoReconciliation__IntervalSeconds=60
MercadoPagoReconciliation__BatchSize=20
MercadoPagoReconciliation__MaxAgeMinutes=180
# Guest Order Access Token (status público limitado)
# Enabled=true exige TokenHashSecret forte (nunca deixe vazio).
GuestOrderAccess__Enabled=true
GuestOrderAccess__TokenTtlDays=30
GuestOrderAccess__TokenHashSecret=dev-only-guest-order-access-secret-change-me
GuestOrderAccess__RateLimitPerMinute=30

# Busca CEP via API Shopflow (provider ViaCEP no backend — frontend não chama externo)
PostalCodeLookup__Enabled=true
PostalCodeLookup__Provider=ViaCep
PostalCodeLookup__BaseUrl=https://viacep.com.br
PostalCodeLookup__TimeoutSeconds=5
PostalCodeLookup__RateLimitPerMinute=60

# Frontend — WhatsApp vendedor (apps/web). Placeholder NÃO-REAL; produção/Pages usam número real só no dashboard.
# VITE_SUPPORT_WHATSAPP_ENABLED=false
# VITE_SUPPORT_WHATSAPP_PHONE=55DDDNUMERO

# Product images — Local (default) | Cloudflare R2 (S3-compatible)
# Dev: Storage__Provider=Local → wwwroot/uploads (Storage__Local__* / Uploads__*)
# TESTE/PROD: Storage__Provider=CloudflareR2 + Storage__R2__* secrets (never commit real keys)
Storage__Provider=Local
Storage__MaxImageBytes=5242880
Storage__Local__RootPath=
Storage__Local__PublicBaseUrl=http://localhost:5127
Storage__R2__Endpoint=
Storage__R2__AccountId=
Storage__R2__Bucket=
Storage__R2__AccessKeyId=
Storage__R2__SecretAccessKey=
Storage__R2__Region=auto
Storage__R2__ForcePathStyle=true
Storage__R2__PublicBaseUrl=
Storage__R2__KeyPrefix=products
# Legacy Uploads_* still accepted as fallback for Local PublicBaseUrl/RootPath
Uploads__RootPath=
Uploads__PublicBaseUrl=http://localhost:5127

# Manual TEST-only local→R2 image backfill (never Production)
R2ImageBackfill__Enabled=false

# Public storefront/admin base URL (links em e-mails transacionais)
PublicApp__BaseUrl=http://localhost:5173
PublicApp__AdminBaseUrl=http://localhost:5173
PublicApp__StoreName=Vip Assessoria
AppUrls__StorefrontBaseUrl=http://localhost:5173
AppUrls__AdminBaseUrl=http://localhost:5173

# Inbox operacional para cadastros pendentes (vazio = não envia e-mail admin)
AdminNotifications__ApprovalRequestsEmail=

# Brevo transactional email (API key never commit)
Brevo__Enabled=false
Brevo__BaseUrl=https://api.brevo.com
Brevo__ApiKey=
Brevo__SenderName=VIP Assessoria Digital
Brevo__SenderEmail=
Brevo__ReplyToName=Atendimento
Brevo__ReplyToEmail=
Brevo__SandboxMode=true
Brevo__TimeoutSeconds=10

# Email outbox worker (processa notifications.email_outbox)
EmailOutbox__Enabled=true
EmailOutbox__IntervalSeconds=15
EmailOutbox__BatchSize=20
EmailOutbox__MaxAttempts=8
EmailOutbox__ProcessingTimeoutSeconds=120

# Dispatcher: orders.email_intents Pending → notifications.email_outbox
OrderEmailIntentDispatcher__Enabled=true
OrderEmailIntentDispatcher__IntervalSeconds=15
OrderEmailIntentDispatcher__BatchSize=20

# Store access / customer approval (ADR). TESTE/HML/PROD deste cliente: loja privada.
# Closed = PrivateCatalogApprovedOnly. Open = PublicCatalogAndGuestCheckout.
StoreAccess__Mode=Closed
CustomerAccess__RequireApproval=true
Checkout__AllowGuest=false
Checkout__AllowGuestCheckout=false
