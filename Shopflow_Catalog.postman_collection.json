    {
      "name": "5. Imagens",
      "item": [
        {
          "name": "[PENDING BACKEND] POST /catalog/products/{{productId}}/images/presigned",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"produto.jpg\",\n  \"contentType\": \"image/jpeg\"\n}"
            },
            "url": "{{baseUrl}}/catalog/products/{{productId}}/images/presigned",
            "description": "Endpoint não implementado em CatalogEndpoints.cs. Mantido para referência futura."
          }
        },
        {
          "name": "POST /catalog/products/{{productId}}/images (multipart)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Selecione um arquivo de imagem (jpg/png)",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/catalog/products/{{productId}}/images",
            "description": "Upload multipart. Campo do formulário: `file` (IFormFile). Execute após criar o produto (pasta 2) e antes do DELETE (pasta 4)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('ProductImageDto', () => {",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('url');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /catalog/products/{{productId}} (com imagens)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/catalog/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Lista images', () => {",
                  "  pm.expect(pm.response.json().images).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
