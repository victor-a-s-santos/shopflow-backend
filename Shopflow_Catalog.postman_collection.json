    "name": "Shopflow — Catalog",
    "description": "Testes de ponta a ponta do módulo Catalog (Shopflow API).\n\nVariável base: `baseUrl` = http://localhost:5127/api\n\nOrdem sugerida: pasta **1. Setup** → **2. Produto com SKUs** → **3. Validações** → **5. Imagens** (opcional) → **4. Delete** (limpeza).\n\nRequer API rodando e seed de categorias/atributos aplicado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5127/api" },
    { "key": "productId", "value": "" },
    { "key": "skuId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "colorDefinitionId", "value": "" },
    { "key": "colorValueId", "value": "" },
    { "key": "sizeDefinitionId", "value": "" },
    { "key": "sizeValueId", "value": "" },
    { "key": "nonExistentSkuId", "value": "00000000-0000-0000-0000-000000000099" }
  ],
  "item": [
    {
      "name": "1. Setup / Consulta base",
      "item": [
        {
          "name": "GET /catalog/categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/catalog/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const cats = pm.response.json();",
                  "pm.test('Lista de categorias', () => pm.expect(cats).to.be.an('array'));",
                  "if (Array.isArray(cats) && cats.length > 0) {",
                  "  pm.collectionVariables.set('categoryId', cats[0].id);",
                  "  console.log('categoryId =', cats[0].id, cats[0].name);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /catalog/attributes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/catalog/attributes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const defs = pm.response.json();",
                  "pm.test('Lista de atributos', () => pm.expect(defs).to.be.an('array'));",
                  "const findDef = (part) => defs.find((d) =>",
                  "  (d.name || '').toLowerCase().includes(part.toLowerCase())",
                  ");",
                  "const findValue = (values, names) => {",
                  "  for (const n of names) {",
                  "    const v = values.find((x) => (x.name || '').toLowerCase() === n.toLowerCase());",
                  "    if (v) return v;",
                  "  }",
                  "  return values[0];",
                  "};",
                  "const cor = findDef('cor');",
                  "const tamanho = findDef('tamanho');",
                  "if (cor) {",
                  "  pm.collectionVariables.set('colorDefinitionId', cor.id);",
                  "  const colorVal = findValue(cor.values || [], ['Preto', 'Off-White']);",
                  "  if (colorVal) {",
                  "    pm.collectionVariables.set('colorValueId', colorVal.id);",
                  "    console.log('Cor:', cor.name, '→', colorVal.name);",
                  "  }",
                  "}",
                  "if (tamanho) {",
                  "  pm.collectionVariables.set('sizeDefinitionId', tamanho.id);",
                  "  const sizeVal = findValue(tamanho.values || [], ['M', 'Único', 'U']);",
                  "  if (sizeVal) {",
                  "    pm.collectionVariables.set('sizeValueId', sizeVal.id);",
                  "    console.log('Tamanho:', tamanho.name, '→', sizeVal.name);",
                  "  }",
                  "}",
                  "pm.test('Cor capturada', () => {",
                  "  pm.expect(pm.collectionVariables.get('colorDefinitionId')).to.not.be.empty;",
                  "  pm.expect(pm.collectionVariables.get('colorValueId')).to.not.be.empty;",
                  "});",
                  "pm.test('Tamanho capturado', () => {",
                  "  pm.expect(pm.collectionVariables.get('sizeDefinitionId')).to.not.be.empty;",
                  "  pm.expect(pm.collectionVariables.get('sizeValueId')).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /catalog/products?page=1&pageSize=20",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/catalog/products?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["catalog", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('PagedProductsDto', () => {",
                  "  pm.expect(body).to.have.property('page');",
                  "  pm.expect(body).to.have.property('items');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
